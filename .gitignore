# Raw feeds: 116 MB compressed, 3 GB expanded. Rebuilt by `make ingest`.
# The pattern is data/raw/* rather than data/raw/ because git cannot re-include
# a file whose parent directory is excluded, and the manifest must be committed:
# it is what proves which bytes produced the published numbers.
data/raw/*
!data/raw/MANIFEST.json
data/interim/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Streamlit / notebooks
.streamlit/secrets.toml
.ipynb_checkpoints/

# OS
.DS_Store
